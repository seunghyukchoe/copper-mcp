(pcb "/tmp/coppermcp-terra-freerouting-real/benchmarks/routing/fixtures/freerouting-common-two-pad-v1.dsn"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.5")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  40000 -30000  0 -30000  0 0  40000 0  40000 -30000)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 200)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component CopperMCP_RoutePad
      (place J1 10000 -15000 front 0 (PN RoutePad))
      (place J2 30000 -15000 front 0 (PN RoutePad))
    )
  )
  (library
    (image CopperMCP_RoutePad
      (pin Rect[T]Pad_2000.000000x2000.000000_um 1 0 0)
    )
    (padstack Rect[T]Pad_2000.000000x2000.000000_um
      (shape (rect F.Cu -1000 -1000 1000 1000))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net AUDIO
      (pins J1-1 J2-1)
    )
    (class kicad_default AUDIO
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
