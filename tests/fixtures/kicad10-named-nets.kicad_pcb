(kicad_pcb
  (version 20260206)
  (generator "pcbnew")
  (layers
    (0 "F.Cu" signal)
    (2 "B.Cu" signal)
  )
  (footprint "Test:R"
    (layer "F.Cu")
    (pad "1" smd rect
      (at 0 0)
      (size 1 1)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net "GND")
    )
    (pad "2" smd rect
      (at 2 0)
      (size 1 1)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net "SIGNAL")
    )
    (pad "3" smd rect
      (at 4 0)
      (size 1 1)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net "")
    )
  )
  (segment
    (start 0 0)
    (end 2 0)
    (width 0.25)
    (layer "F.Cu")
    (net "SIGNAL")
  )
  (via
    (at 2 0)
    (size 0.8)
    (drill 0.4)
    (layers "F.Cu" "B.Cu")
    (net "SIGNAL")
  )
  (zone
    (net "GND")
    (layer "B.Cu")
  )
)
