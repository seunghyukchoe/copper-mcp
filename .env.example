# Copy this file to .env only if your process manager needs one.
# CopperMCP does not load .env files automatically. Never commit real values.

# Required trust boundary: only files below this directory can be inspected.
COPPER_MCP_WORKSPACE=/absolute/path/to/your/pcb-workspace

# Local MCP is the safest default. Use streamable-http only behind authentication.
COPPER_MCP_TRANSPORT=stdio
COPPER_MCP_HOST=127.0.0.1
COPPER_MCP_PORT=8765

# Maximum board size accepted at the filesystem boundary (64 MiB by default).
COPPER_MCP_MAX_BOARD_BYTES=67108864

# Optional authoritative DRC adapter. The executable is auto-discovered when possible.
COPPER_MCP_KICAD_CLI=/absolute/path/to/kicad-cli
COPPER_MCP_KICAD_TIMEOUT_SECONDS=120
COPPER_MCP_MAX_DRC_REPORT_BYTES=8388608
COPPER_MCP_MAX_DRC_CONTEXT_BYTES=134217728
COPPER_MCP_MAX_DRC_CONTEXT_FILES=10000
COPPER_MCP_MAX_DRC_CONTEXT_SCAN_SECONDS=10

# AI is optional and disabled in the reference implementation.
COPPER_MCP_AI_PROVIDER=disabled
