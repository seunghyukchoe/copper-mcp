{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyukchoe/copper-mcp/schemas/drc-summary.schema.json",
  "title": "CopperMCP DRC Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_revision",
    "drc_context_revision",
    "kicad_version",
    "drc_schema",
    "coordinate_units",
    "error_count",
    "warning_count",
    "exclusion_count",
    "ignored_check_count",
    "unconnected_count",
    "violation_type_counts",
    "passed",
    "schema_version"
  ],
  "properties": {
    "base_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "drc_context_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "kicad_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "drc_schema": {"const": "https://schemas.kicad.org/drc.v1.json"},
    "coordinate_units": {"const": "mm"},
    "error_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0},
    "exclusion_count": {"type": "integer", "minimum": 0},
    "ignored_check_count": {"type": "integer", "minimum": 0},
    "unconnected_count": {"type": "integer", "minimum": 0},
    "violation_type_counts": {
      "type": "object",
      "maxProperties": 1000,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "passed": {"type": "boolean"},
    "schema_version": {"const": "1.0"}
  }
}
