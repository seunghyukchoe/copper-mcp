{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyukchoe/copper-mcp/schemas/audio-benchmark-catalog/0.1.0.schema.json",
  "title": "CopperMCP audio benchmark catalog 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "reviewed_on",
    "external_references",
    "fixtures"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../schemas/audio-benchmark-catalog/0.1.0.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "external_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/externalReference"
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 500
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$",
      "maxLength": 300
    },
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "index_url",
        "terms_url",
        "reviewed_on",
        "rights_context",
        "source_rights",
        "reuse_policy",
        "redistribution_allowed",
        "commercial_use_allowed",
        "written_permission_ref",
        "third_party_content_included",
        "safety_class"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "index_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "terms_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "rights_context": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300
        },
        "source_rights": {
          "type": "string",
          "const": "personal-noncommercial"
        },
        "reuse_policy": {
          "type": "string",
          "const": "reference-only"
        },
        "redistribution_allowed": {
          "const": false
        },
        "commercial_use_allowed": {
          "const": false
        },
        "written_permission_ref": {
          "type": "null"
        },
        "third_party_content_included": {
          "const": false
        },
        "safety_class": {
          "type": "string",
          "const": "metadata-only"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clearance_nm",
        "track_width_nm",
        "via_diameter_nm",
        "via_drill_nm"
      ],
      "properties": {
        "clearance_nm": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000000
        },
        "track_width_nm": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000000
        },
        "via_diameter_nm": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000000
        },
        "via_drill_nm": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000000
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_supported",
        "expected_object_counts"
      ],
      "properties": {
        "expected_supported": {
          "type": "boolean"
        },
        "expected_object_counts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "net",
        "layer",
        "seed",
        "expected_status",
        "expected_diagnostic",
        "expected_pad_count"
      ],
      "properties": {
        "net": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "layer": {
          "type": "string",
          "pattern": "^[FB]\\.Cu$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "expected_status": {
          "enum": [
            "routed",
            "not_routed",
            "unsupported_board"
          ]
        },
        "expected_diagnostic": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "expected_pad_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_status": {
                "const": "routed"
              }
            }
          },
          "then": {
            "properties": {
              "expected_diagnostic": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "expected_diagnostic": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "origin",
        "artifact_path",
        "artifact_sha256",
        "license_spdx",
        "license_path",
        "license_sha256",
        "stated_rightsholder",
        "third_party_content_included",
        "derivation_statement",
        "safety_class",
        "constraints",
        "inspection",
        "routes",
        "claims",
        "not_claimed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "origin": {
          "enum": [
            "coppermcp-original",
            "coppermcp-open-hardware"
          ]
        },
        "artifact_path": {
          "$ref": "#/$defs/relativePath"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license_spdx": {
          "enum": [
            "Apache-2.0",
            "CERN-OHL-S-2.0"
          ]
        },
        "license_path": {
          "$ref": "#/$defs/relativePath"
        },
        "license_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stated_rightsholder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "third_party_content_included": {
          "const": false
        },
        "derivation_statement": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "safety_class": {
          "enum": [
            "synthetic-low-voltage",
            "engineering-preview"
          ]
        },
        "constraints": {
          "$ref": "#/$defs/constraints"
        },
        "inspection": {
          "$ref": "#/$defs/inspection"
        },
        "routes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "board-ir-inspection",
              "two-pin-route-preview",
              "multi-pin-route-preview",
              "typed-route-refusal"
            ]
          }
        },
        "not_claimed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          }
        }
      }
    }
  }
}
