{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seunghyukchoe/copper-mcp/schemas/circuit-intent/0.1.0.schema.json",
  "title": "CopperMCP Circuit Intent IR 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "snapshot_digest",
    "content"
  ],
  "properties": {
    "schema": {
      "const": "copper.circuit-intent"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "snapshot_digest": {
      "$ref": "#/$defs/digest"
    },
    "content": {
      "$ref": "#/$defs/content"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "componentId": {
      "type": "string",
      "pattern": "^component:[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "netId": {
      "type": "string",
      "pattern": "^net:[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "portId": {
      "type": "string",
      "pattern": "^port:[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "reference",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "kind": {
          "enum": [
            "resistor",
            "capacitor_unpolarized"
          ]
        },
        "reference": {
          "type": "string",
          "pattern": "^[RC][1-9][0-9]{0,5}$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "pin"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "pin": {
          "enum": [
            "1",
            "2"
          ]
        }
      }
    },
    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "connections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/netId"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.+/:\\-]{0,63}$"
        },
        "connections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/connection"
          }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "net_id",
        "direction"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/portId"
        },
        "net_id": {
          "$ref": "#/$defs/netId"
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "bidirectional",
            "passive"
          ]
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "circuit_id",
        "project_name",
        "title",
        "components",
        "nets",
        "ports"
      ],
      "properties": {
        "circuit_id": {
          "type": "string",
          "pattern": "^circuit:[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "project_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "nets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/net"
          }
        },
        "ports": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/port"
          }
        }
      }
    }
  }
}
