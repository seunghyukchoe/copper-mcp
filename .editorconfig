root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,json,toml}]
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{md,kicad_pcb,kicad_sch}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
